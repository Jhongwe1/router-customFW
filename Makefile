# Makefile -- what a clone of rlxfw can ask for by name.
#
#   make test       the host suites, exactly what CI's build-host job runs
#                   (.github/workflows/build.yml): the six programs' suites
#                   through src/Makefile's `test`, then rlxboot's hosttest.
#   make userspace  the six programs as big-endian MIPS ELFs (src/Makefile's
#                   `target`), which needs the pinned vendor toolchain: TC=.
#   make image      prints the build a recipient runs (docs/release-process.md,
#                   "The build a recipient runs") once its inputs are present.
#                   It builds nothing itself.
#   make docs       spec-check, citecheck and docsize, as CI's text job runs them.
#   make run        v1.0's userspace, cut byte for byte from the release image,
#                   booted on qemu-system-mips -M malta: a simulation, not a
#                   measurement (docs/run.md).  The web API answers on
#                   127.0.0.1:$(RUN_PORT); the console is this terminal.
#   make run-test   the host test of `make run`, then its two red controls,
#                   one qemu at a time.
#   make help       this list.
#
# A goal that cannot run here REFUSES and says what is missing, before it
# starts.  Output goes under O=, absolute, by default build/make in this clone
# (build/ is ignored).
#
# `test` writes each suite's output to $(O)/census/<suite>.out as well as to
# the terminal; tools/ci-census.py reads that directory against
# tools/ci-expected-build.tsv.  The recipe lines are spelled out rather than
# generated by a macro: tools/entrycheck.py's E14 follows `make test` into this
# file and reads the commands as written.

SHELL       := /bin/bash
# pipefail, so that `make ... | tee` fails when make does and not when tee does.
.SHELLFLAGS := -o pipefail -c

HERE      := $(dir $(abspath $(lastword $(MAKEFILE_LIST))))

# The recipes name src/ and tools/ relative to the top of the tree, as CI and
# E14 read them, so make must run there: `make <goal>` at the top, or
# `make -C <tree> <goal>` from anywhere.
ifneq ($(CURDIR)/,$(HERE))
$(error REFUSED: run make at the top of the tree (make -C $(HERE) <goal>), not from $(CURDIR))
endif
O         ?= $(HERE)build/make
PYTHON    ?= /usr/bin/python3
TC        ?=
FWRE_WORK ?= $(HOME)/fwre-work
DROP      := $(FWRE_WORK)/rebuild/src-vendor/rtl819x-toolchain

RUN_PORT  ?= 20080
RUN_CAP   ?= 120
RUN_GREEN ?= 1
RUN_CACHE ?= $(O)/run-cache

.PHONY: help test test-ready userspace userspace-ready image docs run run-test run-ready
.DEFAULT_GOAL := help

help:
	@echo "make test       the host suites CI runs: the six programs and rlxboot's hosttest"
	@echo "make userspace  the six programs for the target; needs TC=<rsdk root>"
	@echo "make image      prints the build a recipient runs; refuses without its inputs"
	@echo "make docs       spec-check, citecheck and docsize, as CI's text job runs them"
	@echo "make run        v1.0's userspace on qemu-system-mips -M malta, API on 127.0.0.1:$(RUN_PORT):"
	@echo "                a simulation, not a measurement (docs/run.md)"
	@echo "make run-test   the host test of make run, and its two red controls"
	@echo "O=$(O)"

# THE MODE PROBE, and why `test` refuses a directory rather than warning.
# httpd's test_routes makes its web root under $TMPDIR, which src/Makefile puts
# under O=, and chmods a fixture 0644; on a filesystem that reports every file
# 0777 (DrvFs, a Windows drive under WSL) send_file() then correctly refuses it
# as executable and five cases fail for a reason that is not the code.  So the
# guard writes a file, sets 0644 and reads the mode back -- the real value,
# not a guess from the path.
test-ready:
	@case "$(O)" in /?*) ;; *) \
	   echo "REFUSED: O=$(O) must be an absolute directory"; exit 1 ;; esac
	@mkdir -p "$(O)" && p="$(O)/.mode-probe" && rm -f "$$p" && touch "$$p" \
	 && chmod 0644 "$$p" && m=$$(stat -c %a "$$p") && rm -f "$$p" \
	 && [ "$$m" = 644 ] || { \
	   echo "REFUSED: O=$(O) does not keep file modes (0644 reads back" \
	        "$${m:-nothing}); httpd's test_routes would fail for that alone --" \
	        "give O= on a Linux filesystem"; exit 1; }
	@miss=; for c in gcc-13 clang-18 sha256sum sha512sum; do \
	   command -v $$c >/dev/null 2>&1 || miss="$$miss $$c"; done; \
	 [ -x "$(PYTHON)" ] || miss="$$miss $(PYTHON)"; \
	 [ -z "$$miss" ] || { echo "REFUSED: make test needs$$miss" \
	   "(Ubuntu 24.04: apt-get install gcc-13 clang-18 libclang-rt-18-dev python3)"; \
	   exit 1; }

test: test-ready
	@rm -rf "$(O)/census" && mkdir -p "$(O)/census"
	$(MAKE) --no-print-directory -C src test O=$(O)/src 2>&1 | tee $(O)/census/host-userspace.out
	$(MAKE) --no-print-directory -C src/rlxboot hosttest STAGE=$(O)/rlxboot 2>&1 | tee $(O)/census/host-rlxboot.out
	@echo "make test: passed -- the six programs' suites and rlxboot's hosttest"

# The target build runs the rsdk gcc 3.4.6 of the pinned drop
# (rsdk-1.3.6-4181-EB-2.6.30-0.9.30), a vendor binary, which src/Makefile runs
# through tools/vendor-tripwire.sh.  The guard reads only the path.
userspace-ready:
	@[ -n "$(TC)" ] || { \
	   echo "REFUSED: make userspace needs TC=<rsdk root>, the pinned vendor" \
	        "toolchain rsdk-1.3.6-4181-EB-2.6.30-0.9.30 from the drop SOURCES.json" \
	        "names (rtl819x-toolchain); no clean clone and no CI runner holds it"; \
	   exit 1; }
	@[ -x "$(TC)/bin/mips-linux-gcc" ] || { \
	   echo "REFUSED: TC=$(TC) holds no executable bin/mips-linux-gcc"; exit 1; }

userspace: userspace-ready
	$(MAKE) --no-print-directory -C src target O=$(O)/target TC=$(TC)

# The pin is read from SOURCES.json and compared with the drop's HEAD: a drop at
# another revision is not the one the release names.
image:
	@[ -d "$(DROP)" ] || { \
	   echo "REFUSED: no vendor drop at $(DROP) -- the image is built from the" \
	        "rtl819x-toolchain drop at its SOURCES.json pin, which a clean clone" \
	        "does not hold (FWRE_WORK=$(FWRE_WORK))"; exit 1; }
	@pin=$$($(PYTHON) -c 'import json, sys; d = json.load(open(sys.argv[1])); \
	   print(next(t["pin"] for t in d["source_trees"] if t["id"] == "rtl819x-toolchain"))' \
	   SOURCES.json) && head=$$(git -C "$(DROP)" rev-parse HEAD 2>/dev/null) \
	 && [ -n "$$pin" ] && [ "$$pin" = "$$head" ] || { \
	   echo "REFUSED: the drop at $(DROP) is at $${head:-no git revision}," \
	        "not SOURCES.json's pin $${pin:-unread}"; exit 1; }
	@echo "The drop is at its pin.  The image is built by tools/rlxfw-kbuild.sh;"
	@echo "a recipient runs, from the top of this tree:"
	@echo
	@echo "    bash tools/rlxfw-kbuild.sh <cell> --variant quiet --marks --jobs 4 \\"
	@echo "         --initramfs <name>.spec --recipient"
	@echo
	@echo "with <name>.spec a tools/mkinitramfs.py spec whose content record sits"
	@echo "beside it.  docs/release-process.md says what the verdict means."

# `run` and `run-test` fetch four pinned inputs into RUN_CACHE (the release's
# SHA256SUMS and image, two Debian buster packages: tools/maltarun-pins.tsv),
# refuse any whose sha256 differs, and boot v1.0's initramfs, cut from the
# image, on Debian's kernel.  Nothing is compiled.  The tag v1.0 must be in the
# clone: the host test reads BK_VERSION_STR from it.  tools/maltarun.py
# refuses, with the reason, whatever else is missing.
run-ready:
	@case "$(O)" in /?*) ;; *) \
	   echo "REFUSED: O=$(O) must be an absolute directory"; exit 1 ;; esac
	@miss=; [ -x "$(PYTHON)" ] || miss="$$miss $(PYTHON)"; \
	 command -v qemu-system-mips >/dev/null 2>&1 || miss="$$miss qemu-system-mips"; \
	 [ -z "$$miss" ] || { echo "REFUSED: make run needs$$miss" \
	   "(Ubuntu 24.04: apt-get install qemu-system-mips python3)"; exit 1; }
	@git rev-parse -q --verify 'v1.0^{commit}' >/dev/null || { \
	   echo "REFUSED: no tag v1.0 in this clone (git fetch --tags)"; exit 1; }

run: run-ready
	$(PYTHON) tools/maltarun.py run --cache $(RUN_CACHE) --out $(O)/run --port $(RUN_PORT)

run-test: run-ready
	$(PYTHON) tools/maltarun.py test --cache $(RUN_CACHE) --out $(O)/run \
	  --port $(RUN_PORT) --cap $(RUN_CAP) --green $(RUN_GREEN)

# spec-check reads the owners SPEC.md names, most of them under upstream/, and
# citecheck reads history: a clone needs --recurse-submodules and no --depth.
docs:
	@[ -n "$$(ls -A upstream 2>/dev/null)" ] || { \
	   echo "REFUSED: upstream/ is empty -- spec-check reads owners there;" \
	        "run git submodule update --init"; exit 1; }
	$(PYTHON) tools/spec-check.py
	$(PYTHON) tools/citecheck.py
	$(PYTHON) tools/docsize.py
