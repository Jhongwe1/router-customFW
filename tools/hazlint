class Controls(object):
    def __init__(self):
        self.rows = []          # (name, ok, detail)
        self.population_ran = False

    def add(self, name, ok, detail):
        self.rows.append((name, bool(ok), detail))
        return ok

    @property
    def failed(self):
        return [r for r in self.rows if not r[1]]


def run_controls(stage2_path, waive_population, want_isa):
    c = Controls()

    # --- K1 --------------------------------------------------------------
    bad = []
    for lw, nw, expect, why in K1_CASES:
        two = Span(0, 8, PAYLOAD_VMA, 'K1')
        two.words = [(PAYLOAD_VMA, lw), (PAYLOAD_VMA + 4, nw)]
        if (len(scan([two]).violations) > 0) != expect:
            bad.append(why)
    c.add('K1  decoder cases', not bad,
          '%d/%d ok  (%d must fire, %d must not)'
          % (len(K1_CASES) - len(bad), len(K1_CASES),
             sum(1 for x in K1_CASES if x[2]),
             sum(1 for x in K1_CASES if not x[2]))
          + ('' if not bad else '   first miss: ' + bad[0]))

    # --- K2 --------------------------------------------------------------
    v1 = unhex(P9_12_V1_HEX)
    sha1_ok = hashlib.sha256(v1).hexdigest() == P9_12_V1_SHA
    r1 = scan(raw_span(v1, PAYLOAD_VMA))
    offs = sorted(v[1] for v in r1.violations)
    c.add('K2  negative control  P9-12 v1, %d B' % len(v1),
          sha1_ok and len(v1) == 148 and offs == [0x1C, 0x2C],
          'sha256 %s; %d violations at %s   (expected 2, at 0x1c and 0x2c)'
          % ('ok' if sha1_ok else 'MISMATCH', len(offs),
             ', '.join('0x%02x' % o for o in offs) or 'none'))

    # --- K3 --------------------------------------------------------------
    v2 = unhex(P9_12_V2_HEX)
    sha2_ok = hashlib.sha256(v2).hexdigest() == P9_12_V2_SHA
    r2 = scan(raw_span(v2, PAYLOAD_VMA))
    # The single-variable claim itself, checked rather than repeated.  Upstream
    # wrote "two nops, nothing else changed", and at the source level that is
    # true; in the bytes it cannot be, because inserting two instructions moves
    # every PC-relative displacement past them and the string base with them.
    # So the assertion is the one that is actually available: strip v2's two
    # nops and every remaining word must match v1 in its top 16 bits -- same
    # opcode, same registers, same control-flow shape -- with each difference
    # confined to a 16-bit immediate.
    NOP_IDX = (0x20 // 4, 0x34 // 4)
    w1 = [struct.unpack_from('>I', v1, i)[0] for i in range(0, len(v1), 4)]
    w2 = [struct.unpack_from('>I', v2, i)[0] for i in range(0, len(v2), 4)]
    ins = (len(w2) == len(w1) + 2
           and all(w2[k] == 0 for k in NOP_IDX))
    moved = []
    if ins:
        stripped = [w for k, w in enumerate(w2) if k not in NOP_IDX]
        moved = [(k, a, b) for k, (a, b) in enumerate(zip(w1, stripped))
                 if a != b]
        ins = all((a >> 16) == (b >> 16) for k, a, b in moved)
    c.add('K3  positive control  P9-12 v2, %d B' % len(v2),
          sha2_ok and r2.loads == 2 and r2.nop_after == 2
          and not r2.violations and ins,
          '%d loads / %d nop / %d violations; v2 is v1 with nops at 0x20 and '
          '0x34 and %d displacement(s) moved, nothing else: %s'
          % (r2.loads, r2.nop_after, len(r2.violations), len(moved),
             'yes' if ins else 'NO'))

    # --- K4, the population control --------------------------------------
    if stage2_path is None:
        detail = ('NOT RUN -- stage2.bin was not found. Looked under $FWRE_WORK '
                  '(%s). Pass --stage2 PATH, or --no-population-control to look '
                  'at a file without certifying it'
                  % os.environ.get('FWRE_WORK', '/home/key/fwre-work'))
        if waive_population:
            c.add('K4  population control  stage2.bin', True,
                  'WAIVED by --no-population-control. Nothing this run says can '
                  'pass a gate; the exit code will be 2 either way')
        else:
            c.add('K4  population control  stage2.bin', False, detail)
    else:
        b = open(stage2_path, 'rb').read()
        sha = hashlib.sha256(b).hexdigest()
        # Through raw_span(), which is exactly what `--raw` builds for a user's
        # file.  It used to have its own private word list, so this control
        # exercised a code path no scanned file ever took -- it could not have
        # caught a defect in span construction, and it looked like it could.
        r = scan(raw_span(b, STAGE2_VMA))
        ok = (sha == STAGE2_SHA and len(b) == STAGE2_SIZE
              and r.loads == STAGE2_LOADS and r.nop_after == STAGE2_NOPS
              and len(r.violations) == STAGE2_VIOLATIONS)
        c.population_ran = ok
        c.add('K4  population control  stage2.bin', ok,
              '%d loads / %d nop (%.2f%%) / %d violations   expected %d / %d / %d'
              % (r.loads, r.nop_after, 100.0 * r.nop_after / max(r.loads, 1),
                 len(r.violations), STAGE2_LOADS, STAGE2_NOPS, STAGE2_VIOLATIONS)
              + ('' if sha == STAGE2_SHA else '   sha256 MISMATCH: %s' % sha))

    # --- K10, the MIPS16 precondition ------------------------------------
    # Added 2026-08-27.  Until then this tool read MIPS16 as MIPS32 on the one
    # artefact where it matters, and reported numbers for it.  Four cases: the
    # detector must fire on a jalx into the span, must NOT fire when the same
    # jalx points outside it, must NOT fire when the same word is a jal, and
    # must NOT fire on `stage2.bin` at population scale.
    def _m16_fixture(target, opcode=MIPS16_JALX, in_padding=False, dilute=0):
        ws = [0x25280001] * 200                       # addiu t0,t1,1
        for k in range(20, 180, 6):
            ws[k] = 0x0C000000 | ((k + 3) & 0x03FFFFFF)
        ws[100] = (opcode << 26) | ((target >> 2) & 0x03FFFFFF)
        if in_padding:
            ws[99] = ws[101] = ws[102] = 0
        if dilute:
            # Replace `dilute` of the 128 words the codeness window sees around
            # index 100 with words no MIPS32 decoder would take. 0x4Fxxxxxx is
            # primary opcode 0x13 with a CO bit set -- outside COMMON, and not
            # a small integer, so it is rejected by _m16_plausible on its own
            # terms rather than by a special case.
            put = 0
            for k in range(36, 164):
                if put >= dilute:
                    break
                if k == 100 or ws[k] != 0x25280001:
                    continue
                ws[k] = 0x4F000000 | k
                put += 1
        sp = Span(0, 4 * len(ws), PAYLOAD_VMA, 'K10')
        sp.words = [(PAYLOAD_VMA + 4 * i, w) for i, w in enumerate(ws)]
        return [sp]

    k10 = []
    k10.append(('jalx into the span fires',
                len(mips16_in_spans(_m16_fixture(PAYLOAD_VMA + 0x80))) == 1))
    k10.append(('jalx outside it does not',
                len(mips16_in_spans(_m16_fixture(PAYLOAD_VMA + 0x40000))) == 0))
    k10.append(('the same word as jal does not',
                len(mips16_in_spans(_m16_fixture(PAYLOAD_VMA + 0x80, 0x03))) == 0))
    k10.append(('a jalx sitting in zero padding does not',
                len(mips16_in_spans(
                    _m16_fixture(PAYLOAD_VMA + 0x80, in_padding=True))) == 0))
    # The codeness cut is a chosen number, and until these two it was pinned by
    # nothing: 量 2026-08-28 by the adversarial review, every cut from 0 to 99
    # and every window from 4 to 512 passed all of K10 and the whole self-test,
    # while `score < 99` -- two characters -- dropped the kernel's hit count
    # 179 -> 18 and turned the `.iram` refusal into a printed report. These two
    # bracket it: a window diluted to ~87 % plausible must still fire, one
    # diluted to ~65 % must not. Together they pin the cut into [66, 87], which
    # is the empty band the docstring records.
    k10.append(('a lightly diluted window still fires',
                len(mips16_in_spans(
                    _m16_fixture(PAYLOAD_VMA + 0x80, dilute=16))) == 1))
    k10.append(('a heavily diluted window does not',
                len(mips16_in_spans(
                    _m16_fixture(PAYLOAD_VMA + 0x80, dilute=45))) == 0))
    if stage2_path is not None:
        b2 = open(stage2_path, 'rb').read()
        k10.append(('stage2.bin at population scale',
                    len(mips16_in_spans(raw_span(b2, STAGE2_VMA))) == 0))
    bad10 = [w for w, ok in k10 if not ok]
    c.add('K10 MIPS16 precondition', not bad10,
          '%d/%d ok  (%s)%s'
          % (len(k10) - len(bad10), len(k10),
             '; '.join(w for w, _ in k10),
             '' if not bad10 else '   first miss: ' + bad10[0]))

    # --- K4b, the second population control -------------------------------
    kpath = find_kernel()
    if kpath is None:
        c.add('K4b population control  vendor kernel', True,
              'NOT RUN -- the decompressed vendor kernel was not found under '
              '$FWRE_WORK (%s). It is 3.3 MB carved from one physical device '
              'and cannot be committed. K4 still ran, so this is a smaller '
              'population, not none: the exit code is unaffected'
              % os.environ.get('FWRE_WORK', '/home/key/fwre-work'))
    else:
        bk = open(kpath, 'rb').read()
        ksha = hashlib.sha256(bk).hexdigest()
        if ksha != KERNEL_SHA or len(bk) != KERNEL_SIZE:
            c.add('K4b population control  vendor kernel', False,
                  'sha256 %s / %d bytes -- expected %s / %d. A control that '
                  'silently ran against a different file is worse than one that '
                  'did not run' % (ksha[:16] + '...', len(bk),
                                   KERNEL_SHA[:16] + '...', KERNEL_SIZE))
        else:
            ksp = raw_span(bk, KERNEL_VMA, 0, KERNEL_TEXT_HI)
            m16 = mips16_in_spans(ksp)
            rk = scan(ksp)
            okk = (not m16
                   and rk.loads == KERNEL_LOADS and rk.nop_after == KERNEL_NOPS
                   and len(rk.violations) == KERNEL_VIOLATIONS
                   and len(rk.unresolved) == KERNEL_UNRESOLVED)
            c.add('K4b population control  vendor kernel', okk,
                  '%d loads / %d nop (%.2f%%) / %d violations / %d unresolved   '
                  'expected %d / %d / %d / %d; MIPS16 in span: %d (must be 0)'
                  % (rk.loads, rk.nop_after,
                     100.0 * rk.nop_after / max(rk.loads, 1),
                     len(rk.violations), len(rk.unresolved),
                     KERNEL_LOADS, KERNEL_NOPS, KERNEL_VIOLATIONS,
                     KERNEL_UNRESOLVED, len(m16)))

    # --- K5 --------------------------------------------------------------
    swapped = b''.join(struct.pack('>I', struct.unpack_from('<I', v1, i)[0])
                       for i in range(0, len(v1), 4))
    n_swapped = len(scan(raw_span(swapped, PAYLOAD_VMA)).violations)
    n_shifted = len(scan(raw_span(v1[2:], PAYLOAD_VMA)).violations)
    c.add('K5  endianness and alignment',
          n_swapped != 2 and n_shifted != 2,
          'byte-swapped -> %d violations, 2-byte shifted -> %d; both must '
          'differ from 2' % (n_swapped, n_shifted))

    # --- K7, delay-slot successors ---------------------------------------
    # K1 is two words, so it cannot reach the shape that matters here: what
    # executes after a load that is ITSELF in a delay slot.  Every case below
    # puts a clean instruction on the leg that is not taken and a reading one on
    # the leg that is, so a checker that resolves to the wrong leg reports 0.
    # Added 2026-08-24; three of the four would have caught a defect that
    # shipped, and nothing in K1-K6 constrained any of them.
    bad7 = []
    for words, viol, unres, rel, why in K7_CASES:
        sp = Span(0, 4 * len(words), 0x80500000, 'K7', relocatable=rel)
        sp.words = [(0x80500000 + 4 * i, w) for i, w in enumerate(words)]
        r7 = scan([sp])
        if (len(r7.violations) != viol) or ((len(r7.unresolved) > 0) != unres):
            bad7.append('%s (got %d violations, %d unresolved)'
                        % (why, len(r7.violations), len(r7.unresolved)))
    c.add('K7  delay-slot successors', not bad7,
          '%d/%d ok' % (len(K7_CASES) - len(bad7), len(K7_CASES))
          + ('' if not bad7 else '   first miss: ' + bad7[0]))

    # --- K8, the span boundary -------------------------------------------
    # Two spans are not one run of instructions.  The last word of one is not
    # the predecessor of the first word of the next, and a flat word list makes
    # it one.  Expect: no violation across the seam, and an unresolved saying
    # why -- not silence.
    a = Span(0, 4, 0x80500000, 'first')
    a.words = [(0x80500000, 0x8D280000)]                  # lw t0,0(t1)
    bsp = Span(4, 4, 0x81000000, 'second')
    bsp.words = [(0x81000000, 0x01005021)]                # addu t2,t0,zero
    r8 = scan([a, bsp])
    c.add('K8  span boundary',
          len(r8.violations) == 0 and len(r8.unresolved) >= 1,
          '%d violations across the seam (must be 0), %d unresolved (must be '
          '>= 1): the two spans are not adjacent and the tool says so rather '
          'than reading across' % (len(r8.violations), len(r8.unresolved)))

    # --- K6, only where it is load-bearing -------------------------------
    if want_isa:
        if stage2_path is None:
            c.add('K6  ISA fixture  stage2.bin', bool(waive_population),
                  'NOT RUN -- stage2.bin was not found')
        else:
            b = open(stage2_path, 'rb').read()
            ws = raw_span(b, STAGE2_VMA)[0].words
            code = [x for x in ws if x[0] < STAGE2_CODE_HI]
            data = [x for x in ws if x[0] >= STAGE2_CODE_HI]
            s_code, l_code = isa_scan(code, True), isa_scan(code, False)
            movz = sorted(a for a, w, m, lv in s_code if m == 'movz')
            movn = sorted(a for a, w, m, lv in s_code if m == 'movn')
            addr_ok = (movz == STAGE2_MOVZ and movn == STAGE2_MOVN)
            c.add('K6a ISA fixture, code region',
                  len(s_code) == 18 and len(l_code) == 18 and addr_ok,
                  '%d hits strict, %d loose; movz x%d, movn x%d; the addresses '
                  'match docs §9 one for one: %s'
                  % (len(s_code), len(l_code), len(movz), len(movn),
                     'yes' if addr_ok else 'NO'))

            l_data, s_data = isa_scan(data, False), isa_scan(data, True)
            ll_hit = any(a == STAGE2_DATA_LL and m == 'll'
                         for a, w, m, lv in l_data)
            movn_hits = sorted(a for a, w, m, lv in l_data
                               if m == 'movn' and a in STAGE2_DATA_MOVN)
            c.add('K6b ISA fixture, the data region fires',
                  ll_hit and movn_hits == sorted(STAGE2_DATA_MOVN),
                  'loose finds ll at 0x%08x (%s) and %d/6 of the SPI table\'s '
                  '0x0000004b -- the two false positives docs §9 names'
                  % (STAGE2_DATA_LL, '192.168.0.1' if ll_hit else 'NOT FOUND',
                     len(movn_hits)))

            rejects = not any(a in STAGE2_DATA_MOVN for a, w, m, lv in s_data)
            counts_ok = (len(l_data) == STAGE2_DATA_LOOSE
                         and len(s_data) == STAGE2_DATA_STRICT)
            c.add('K6c strict and loose disagree, which is the point',
                  rejects and len(l_data) != len(s_data) and counts_ok,
                  'data region: %d loose, %d strict (expected %d / %d). Strict '
                  'rejects the SPI table\'s 0x4b because its sa field is 1: %s. '
                  'A count quoted without its classifier is not a measurement'
                  % (len(l_data), len(s_data), STAGE2_DATA_LOOSE,
                     STAGE2_DATA_STRICT, 'yes' if rejects else 'NO'))

            # K6d.  The label, on the artefact rather than on a fixture.  The
            # defect this replaced was invisible to every count in K6a-K6c:
            # `COP1X (MIPS-IV)` beside 97 words on a core with no MIPS-IV.
            # BOTH classifiers, and the second one was added after an
            # adversarial reader showed that a mutant labelling the 52 CO words
            # `MIPS-IV` under `strict` alone passed everything: K9 compared
            # mnemonics, this compared loose, and the rs sweep ran loose. A
            # level is a claim about an ISA, and it needs checking in the
            # classifier a reader is actually shown -- which is `strict`.
            cop1x = [a for cl in (l_data, s_data)
                     for a, w, m, lv in cl
                     if lv == 'MIPS-IV' and (w >> 26) == 0x13]
            cop3 = [a for a, w, m, lv in l_data if lv.startswith('COP3')
                    or lv == 'MIPS-I COP3']
            c.add('K6d no 0x13 word is labelled MIPS-IV',
                  not cop1x and len(cop3) == 97,
                  '%d of the data region\'s opcode-0x13 words carry a MIPS-IV '
                  'level in either classifier (must be 0); %d carry a COP3 one '
                  'under loose (must be 97, the count '
                  'docs/probe3-cells.md 1.2 records)'
                  % (len(cop1x), len(cop3)))

    # --- K9, the COP3 classification itself ------------------------------
    # K6a-K6d are counts over one file.  A count cannot say WHICH answer each
    # word got, and the 2026-08-27 defect was entirely in the answer: every
    # count K6 had was already correct while every name beside it was wrong.
    bad9, named_bad = [], 0
    for w, mnem, level, smnem, why in K9_CASES:
        got_l = isa_hit(w, False)
        got_s = isa_hit(w, True)
        if got_l != (mnem, level):
            named_bad += 1
            bad9.append('loose  0x%08x -> %r, expected %r   [%s]'
                        % (w, got_l, (mnem, level), why))
        elif (got_s is None) != (smnem is None) or (
                got_s is not None and got_s != (smnem, level)):
            # `got_s != (smnem, level)`, not `got_s[0] != smnem`: the level is
            # half the claim, and comparing the mnemonic alone left a mutant
            # that printed `cop3  MIPS-IV` under strict passing the whole
            # suite -- named in the 2026-08-27 review's "what it did not
            # cover" section, and closed here rather than filed.
            named_bad += 1
            bad9.append('strict 0x%08x -> %r, expected %r   [%s]'
                        % (w, got_s, smnem and (smnem, level), why))
    # And the rs field exhaustively, because the eight cases above touch six of
    # its thirty-two values.  No COP3 word may come back MIPS-IV, and none may
    # come back None under loose: `opcode 0x13 is not on the list` is the
    # sentence this tool spent three days being wrong about.
    for rs in range(32):
        for f in (0x00, 0x2C):
            w = 0x4C000000 | (rs << 21) | f
            h = isa_hit(w, False)
            if h is None:
                bad9.append('loose 0x%08x (rs=%d) -> None; every COP3 word is '
                            'on the watch list' % (w, rs))
            elif h[1] == 'MIPS-IV':
                bad9.append('loose 0x%08x (rs=%d) -> MIPS-IV' % (w, rs))
    # The invariant that makes `strict` mean anything: it is a NARROWING of
    # loose, never a different question.  If strict ever fires where loose does
    # not, K6c's two totals are not comparable and the sentence "a count quoted
    # without its classifier is not a measurement" has no arithmetic under it.
    # Swept rather than argued -- 4,096 words per opcode family, and the whole
    # primary opcode space coarsely, because the 2026-08-27 change is the first
    # one to give an opcode a strict rule that is not a funct table.
    swept = 0
    for rs in range(32):
        for rt in range(32):
            for low in (0x000, 0x001, 0x144, 0x7FF):
                w = 0x4C000000 | (rs << 21) | (rt << 16) | low
                swept += 1
                if isa_hit(w, True) is not None and isa_hit(w, False) is None:
                    bad9.append('0x%08x fires strict and not loose' % w)
                if not isinstance(text(w), str):
                    bad9.append('0x%08x: text() returned a non-string' % w)
    for op in range(64):
        for rs in (0, 1, 2, 4, 6, 8, 0x10, 0x1F):
            for f in (0x00, 0x0A, 0x0F, 0x2C, 0x3F):
                w = (op << 26) | (rs << 21) | f
                swept += 1
                if isa_hit(w, True) is not None and isa_hit(w, False) is None:
                    bad9.append('0x%08x fires strict and not loose' % w)
    c.add('K9  coprocessor 3, at all three of its opcodes', not bad9,
          '%d/%d named cases ok; %d words swept for strict-implies-loose'
          % (len(K9_CASES) - named_bad, len(K9_CASES), swept)
          + ('' if not bad9 else '   first miss: ' + bad9[0]))
    return c


# --------------------------------------------------------------------------
# Reporting
# --------------------------------------------------------------------------

def print_controls(c):
    print('controls   (every one can fail, and the run stops if one does)')
    for name, ok, detail in c.rows:
        print('  %-5s %-38s %s' % ('ok' if ok else 'FAIL', name, detail))
    print('')


def print_spans(path, spans, unscanned):
    print('file       %s   (%d bytes)' % (path, os.path.getsize(path)))
    for sp in spans:
        print('scanned    %-12s file[0x%x .. 0x%x)  ->  vma[0x%08x .. 0x%08x)%s'
              % (sp.name, sp.off, sp.off + sp.size, sp.vaddr,
                 sp.vaddr + sp.size,
                 '   ADDRESSES ARE SYNTHETIC' if not sp.addressed else ''))
    # What was NOT looked at, printed every run.  An executable payload can hide
    # in a segment that is not marked executable, and one tiny PF_X segment is
    # enough to satisfy the loads > 0 guard while the real code goes unscanned.
    for name, size, why in unscanned:
        print('NOT SCANNED %-11s %d bytes -- %s' % (name, size, why))
    if not unscanned:
        print('not scanned  nothing: every allocated part of this file was read')


def report(path, spans, unscanned, r, args, sur):
    print_spans(path, spans, unscanned)
    print('words      %d' % r.words)
    print('')
    print('  loads (MIPS-I load-to-GPR, rt != $zero)   %8d' % r.loads)
    print('  followed by an explicit nop               %8d   (%.2f%%)'
          % (r.nop_after, 100.0 * r.nop_after / max(r.loads, 1)))
    print('  successor unresolved                      %8d' % len(r.unresolved))
    print('  notes (a stated limit, not a finding)     %8d' % len(r.notes))
    print('  VIOLATIONS                                %8d' % len(r.violations))
    print('')

    if r.violations:
        print('  a load whose result is read by the very next instruction. On')
        print('  this core that read gets the PREVIOUS value: no fault, no')
        print('  warning, just wrong.')
        print('')
        for n, v in enumerate(r.violations):
            va, fo, mnem, rt, sa_, sw, why, lw = v
            if args['max_report'] and n >= args['max_report']:
                print('  ... %d more; --max-report 0 prints all'
                      % (len(r.violations) - args['max_report']))
                break
            print('  0x%08x  file 0x%-5x  %-30s  %08x  |%s|'
                  % (va, fo, text(lw), lw, ascii_of(lw)))
            print('  0x%08x  %-12s  %-30s  %08x  |%s|'
                  % (sa_, '', text(sw), sw, ascii_of(sw)))
            print('  %-12s %-12s  reads $%s   [%s]' % ('', '', REGS[rt], why))
            print('')

    if r.unresolved:
        print('  successors that could not be resolved -- reported, not guessed.')
        print('  These fail the gate: an unchecked successor is an unchecked load.')
        for va, fo, reason in r.unresolved[:20]:
            print('    0x%08x  file 0x%-5x  %s' % (va, fo, reason))
        if len(r.unresolved) > 20:
            print('    ... %d more' % (len(r.unresolved) - 20))
        print('')

    if r.notes:
        print('  notes -- the successor WAS checked; what this file cannot rule')
        print('  out is a second one. Stated, not counted as a finding:')
        for va, fo, reason in r.notes[:10]:
            print('    0x%08x  file 0x%-5x  %s' % (va, fo, reason))
        if len(r.notes) > 10:
            print('    ... %d more' % (len(r.notes) - 10))
        print('')

    if sur is not None:
        print('  survey -- hazard shapes with NO established rule on this core.')
        print('  C-9 / F47 is open and R1b owns it. Counts, not verdicts.')
        for k in sorted(sur):
            v = sur[k]
            print('    %-32s %5d   %s'
                  % (k, len(v), ' '.join('0x%08x' % a for a in v[:6])
                     + (' ...' if len(v) > 6 else '')))
        print('')


def report_isa(path, spans, unscanned, args):
    strict = not args['loose']
    rng = args['code_range']
    words = [w for sp in spans for w in sp.words]
    print_spans(path, spans, unscanned)
    print('classifier %s   -- strict also requires the fields an encoding fixes '
          'at zero to BE zero; --loose reads opcode and funct only'
          % ('loose' if args['loose'] else 'strict'))
    print('')
    if rng is None:
        groups = [('everything scanned', words, True)]
    else:
        lo, hi = rng
        groups = [('code   [0x%08x, 0x%08x)' % (lo, hi),
                   [x for x in words if lo <= x[0] < hi], True),
                  ('data   outside that range',
                   [x for x in words if not (lo <= x[0] < hi)], False)]
    bad = 0
    for label, ws, is_code in groups:
        hits = isa_scan(ws, strict)
        other = isa_scan(ws, not strict)
        print('  %-34s %6d words   %4d hits   (%d under --%s)'
              % (label, len(ws), len(hits), len(other),
                 'strict' if args['loose'] else 'loose'))
        by = {}
        for a, w, m, lv in hits:
            by.setdefault((m, lv), []).append((a, w))
        for key in sorted(by):
            m, lv = key
            v = by[key]
            print('      %-18s %-12s %4d' % (m, lv, len(v)))
            lim = args['max_report'] or len(v)
            for a, w in v[:lim]:
                print('          0x%08x  %08x  |%s|   %s'
                      % (a, w, ascii_of(w), text(w)))
            if len(v) > lim:
                print('          ... %d more' % (len(v) - lim))
        if is_code:
            bad += len(hits)
        print('')
    print('  Every hit prints its word and its ASCII so a reader can overturn')
    print('  it. That is the fix docs/loader-command-semantics.md §9 arrived at:')
    print('  the answer to a decoder reading a string table is not a better')
    print('  decoder, it is a tool that puts its evidence beside its verdict.')
    return bad


# --------------------------------------------------------------------------
# Entry point
# --------------------------------------------------------------------------

def parse_args(argv):
    a = {'path': None, 'base': 0, 'range': None, 'raw': False, 'section': None,
         'survey': False, 'max_report': 20, 'stage2': None, 'no_pop': False,
         'allow_zero': False, 'isa': False, 'loose': False, 'code_range': None,
         'self_test': False, 'allow_mips16': False}
    flags = {'--self-test': 'self_test', '--isa': 'isa', '--loose': 'loose',
             '--raw': 'raw', '--survey': 'survey',
             '--no-population-control': 'no_pop',
             '--allow-zero-loads': 'allow_zero',
             '--allow-mips16': 'allow_mips16'}
    i = 0
    while i < len(argv):
        x = argv[i]
        if x in flags:
            a[flags[x]] = True
            i += 1
        elif x == '--base':
            a['base'] = int(argv[i + 1], 0); i += 2
        elif x == '--stage2':
            a['stage2'] = argv[i + 1]; i += 2
        elif x == '--section':
            a['section'] = argv[i + 1]; i += 2
        elif x == '--max-report':
            a['max_report'] = int(argv[i + 1], 0); i += 2
        elif x in ('--range', '--code-range'):
            lo, hi = argv[i + 1].split(':')
            a['range' if x == '--range' else 'code_range'] = \
                (int(lo, 0), int(hi, 0))
            i += 2
        elif x.startswith('-'):
            die('unknown option %s' % x)
        else:
            if a['path'] is not None:
                die('more than one file given')
            a['path'] = x
            i += 1
    return a


def main(argv):
    args = parse_args(argv)

    print('hazlint %s -- a load whose result is read in the delay slot' % VERSION)
    print('the failure this exists to stop: upstream P9-12, 2026-08-21, on this')
    print('physical device. The delay slot was filled. It was filled wrong.')
    print('')

    if args['stage2'] and not os.path.isfile(args['stage2']):
        die('--stage2 %s: no such file. This does NOT fall back to $FWRE_WORK: '
            'a tool that quietly ran its control against a different file from '
            'the one it was told to is the exact failure this repository keeps '
            'catching' % args['stage2'])

    stage2 = find_stage2(args['stage2'])
    c = run_controls(stage2, args['no_pop'],
                     want_isa=args['isa'] or args['self_test'])
    print_controls(c)

    if args['self_test']:
        nf = len(c.failed)
        if nf:
            print('RESULT: %d passed, \033[31m%d failed\033[0m'
                  % (len(c.rows) - nf, nf))
            return 2
        print('RESULT: \033[32m%d passed, 0 failed\033[0m' % len(c.rows))
        if not c.population_ran:
            print('        -- but the population control did not run, so this '
                  'says nothing about whether the tool is looking.')
            return 2
        return 0

    if c.failed:
        print('REFUSED: %d control(s) failed. Nothing is reported about the file'
              % len(c.failed))
        print('         until the checker itself is trusted.')
        return 2

    if args['path'] is None:
        die('no file given. --self-test runs the controls alone; the usage note '
            'is at the bottom of the docstring')
    if not os.path.isfile(args['path']):
        die('%s: no such file' % args['path'])

    b = open(args['path'], 'rb').read()
    unscanned = []
    elf = None if args['raw'] else elf_ranges(b, args['section'])
    if elf is None:
        lo, hi = args['range'] if args['range'] else (0, len(b))
        spans = raw_span(b, args['base'], lo, hi)
    else:
        spans, unscanned = elf
        spans = load_spans(b, spans)
    if not spans or not any(sp.words for sp in spans):
        die('nothing to scan')

    m16 = mips16_in_spans(spans)
    if m16 and not args['allow_mips16']:
        print('REFUSED: this range contains MIPS16. %d jalx target(s) land '
              'inside it,' % len(m16))
        print('         %d distinct; first: %s'
              % (len(set(t for _, t in m16)),
                 ', '.join('0x%08x -> 0x%08x' % h for h in m16[:3])))
        print('         Every number this tool produces comes from a 4-byte '
              'scan, and MIPS16')
        print('         instructions are two bytes: half of them would be '
              'invisible and the')
        print('         other half read glued to a neighbour. That is not a '
              'conservative')
        print('         answer, it is no answer. Bound the range to the 32-bit '
              'part, or pass')
        print('         --allow-mips16 if you know what you are asking for.')
        return 2

    if args['isa']:
        bad = report_isa(args['path'], spans, unscanned, args)
        if not c.population_ran:
            print('')
            print('POPULATION CONTROL NOT RUN -- this run certifies nothing. '
                  'Exit 2.')
            return 2
        return 1 if bad else 0

    sur = survey(spans) if args['survey'] else None
    r = scan(spans)
    report(args['path'], spans, unscanned, r, args, sur)

    if r.loads == 0 and not args['allow_zero']:
        print('REFUSED: %d words scanned and not one load. That is exactly what '
              'a tool' % r.words)
        print('         that is not looking reports. --allow-zero-loads if the '
              'payload really has none.')
        return 2
    if not c.population_ran:
        print('POPULATION CONTROL NOT RUN -- this run certifies nothing, clean '
              'or not. Exit 2.')
        return 2
    if r.violations:
        print('RESULT: \033[31m%d violation(s)\033[0m. This payload must not be '
              'run on this core.' % len(r.violations))
        return 1
    if r.unresolved:
        print('RESULT: 0 violations, but %d successor(s) could not be resolved.'
              % len(r.unresolved))
        print('        Read them above before treating this as clean.')
        return 1
    print('RESULT: \033[32m0 violations\033[0m in %d loads, and the controls '
          'that could have said otherwise held.' % r.loads)
    return 0


if __name__ == '__main__':
    if len(sys.argv) < 2:
        sys.stderr.write(__doc__)
        sys.exit(3)
    sys.exit(main(sys.argv[1:]))
