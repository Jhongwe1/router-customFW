    ([0x45000002, _LW_T0, _NOP, _USE_T0], 1, False, False,
     "bc1f +2 (coprocessor branch): reads() modelled it, control_flow did not"),
    ([0x4D010002, _LW_T0, _NOP, _USE_T0], 1, False, False,
     "bc3t +2: the same gap one coprocessor along, and it survived the "
     "2026-08-24 sweep because opcode 0x13 was being read as COP1X, which is "
     "not a branch at all. Without the fix the successor resolves to the "
     "fall-through nop alone and this case reports 0"),
    ([0x03E00008, _LW_T0, _USE_T0], 0, True, False,
