def unhex(h):
    return bytes(bytearray(int(h[i:i + 2], 16) for i in range(0, len(h), 2)))


# K4b.  The second population control, 87x the size of K4 and on the one
# artefact in this project that is both real code and this machine's own: the
# LZMA-decompressed vendor kernel out of this unit's flash dump.
#
# The span is 0x80000000 .. 0x802B8000 and the upper bound is NOT chosen.  It is
# `__iram`, read out of the image itself at 0x8000226C, where
# `arch/rlx/mm/imem-dmem.S` materialises the I-MEM window base:
#
#     80002268  3c08802c  lui   t0,0x802c
#     8000226c  25088000  addiu t0,t0,-0x8000      -> 0x802B8000
#
# Above it lie `.iram` and `.dram`, which hold MIPS16 (see mips16_in_spans) and
# literal pools.  Below it the range is 32-bit MIPS throughout.
#
# The 58 violations are pinned rather than adjudicated away, and what they are
# is known: a table of kernel pointers at 0x802B4754-0x802B48E0 and
# 0x802B5410-0x802B5448 whose words all begin 0x80, so each decodes as `lb` and
# each appears to read the register the previous one wrote.  量 2026-08-27,
# bounding at 0x802B4000 instead gives 127,650 loads and ZERO violations -- but
# that bound was picked after seeing where the violations were, and this project
# does not bound a region by the answer it produces.  So the honest bound is
# pinned here and the zero is written down in notes/vendor-kernel-isa.md §7.2
# as the adjudication it is.
KERNEL_SHA = 'cf0d60a8ae54352e4d7d451b08a2f5551c80d8a34bf5cced19f3440dba610ec0'
KERNEL_SIZE = 3374772
KERNEL_VMA = 0x80000000
KERNEL_TEXT_HI = 0x2B8000          # __iram, read out of the image
KERNEL_LOADS = 128440
KERNEL_NOPS = 40182
KERNEL_VIOLATIONS = 58
KERNEL_UNRESOLVED = 3


