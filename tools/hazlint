_USE_T0  = 0x01005021       # addu t2,t0,zero
_NOP     = 0x00000000
K7_CASES = [
    ([0x10000002, _LW_T0, _USE_T0, _USE_T0], 1, False, False,
     "b +2, load in the delay slot: only the TARGET executes, so exactly one "
     "of the two reads is a violation"),
    ([0x05230002, _LW_T0, _NOP, _USE_T0], 1, False, False,
     "bgezl t1,+2 (REGIMM branch-likely): the taken leg reads it. control_flow "
     "did not recognise the four REGIMM branch-likely forms until 2026-08-24"),
    ([0x45000002, _LW_T0, _NOP, _USE_T0], 1, False, False,
     "bc1f +2 (coprocessor branch): reads() modelled it, control_flow did not"),
    ([0x03E00008, _LW_T0, _USE_T0], 0, True, False,
     "jr ra: the successor is not statically known, so it is reported "
     "unresolved rather than checked against the next word"),
    ([0x0C140000, _LW_T0, _USE_T0], 0, True, True,
     "jal in an unlinked object: the target field is a placeholder, so a "
     "computed target would be a fiction. Unresolved, not address 0"),
]


def unhex(h):
    return bytes(bytearray(int(h[i:i + 2], 16) for i in range(0, len(h), 2)))


def find_stage2(explicit):
    cands = []
    if explicit:
        cands.append(explicit)
    work = os.environ.get('FWRE_WORK', '/home/key/fwre-work')
    cands += [os.path.join(work, 'stage2.bin'),
              os.path.join(work, 'rebuild', 'work-item4', 'stage2.bin')]
    for c in cands:
        if c and os.path.isfile(c):
            return c
    return None


class Controls(object):
    def __init__(self):
        self.rows = []          # (name, ok, detail)
        self.population_ran = False

    def add(self, name, ok, detail):
        self.rows.append((name, bool(ok), detail))
        return ok

    @property
    def failed(self):
        return [r for r in self.rows if not r[1]]


def run_controls(stage2_path, waive_population, want_isa):
    c = Controls()

    # --- K1 --------------------------------------------------------------
    bad = []
    for lw, nw, expect, why in K1_CASES:
        two = Span(0, 8, PAYLOAD_VMA, 'K1')
        two.words = [(PAYLOAD_VMA, lw), (PAYLOAD_VMA + 4, nw)]
        if (len(scan([two]).violations) > 0) != expect:
            bad.append(why)
    c.add('K1  decoder cases', not bad,
          '%d/%d ok  (%d must fire, %d must not)'
          % (len(K1_CASES) - len(bad), len(K1_CASES),
             sum(1 for x in K1_CASES if x[2]),
             sum(1 for x in K1_CASES if not x[2]))
          + ('' if not bad else '   first miss: ' + bad[0]))

    # --- K2 --------------------------------------------------------------
    v1 = unhex(P9_12_V1_HEX)
    sha1_ok = hashlib.sha256(v1).hexdigest() == P9_12_V1_SHA
    r1 = scan(raw_span(v1, PAYLOAD_VMA))
    offs = sorted(v[1] for v in r1.violations)
    c.add('K2  negative control  P9-12 v1, %d B' % len(v1),
          sha1_ok and len(v1) == 148 and offs == [0x1C, 0x2C],
          'sha256 %s; %d violations at %s   (expected 2, at 0x1c and 0x2c)'
          % ('ok' if sha1_ok else 'MISMATCH', len(offs),
             ', '.join('0x%02x' % o for o in offs) or 'none'))

    # --- K3 --------------------------------------------------------------
    v2 = unhex(P9_12_V2_HEX)
    sha2_ok = hashlib.sha256(v2).hexdigest() == P9_12_V2_SHA
    r2 = scan(raw_span(v2, PAYLOAD_VMA))
    # The single-variable claim itself, checked rather than repeated.  Upstream
    # wrote "two nops, nothing else changed", and at the source level that is
    # true; in the bytes it cannot be, because inserting two instructions moves
    # every PC-relative displacement past them and the string base with them.
    # So the assertion is the one that is actually available: strip v2's two
    # nops and every remaining word must match v1 in its top 16 bits -- same
    # opcode, same registers, same control-flow shape -- with each difference
    # confined to a 16-bit immediate.
    NOP_IDX = (0x20 // 4, 0x34 // 4)
    w1 = [struct.unpack_from('>I', v1, i)[0] for i in range(0, len(v1), 4)]
    w2 = [struct.unpack_from('>I', v2, i)[0] for i in range(0, len(v2), 4)]
    ins = (len(w2) == len(w1) + 2
           and all(w2[k] == 0 for k in NOP_IDX))
    moved = []
    if ins:
        stripped = [w for k, w in enumerate(w2) if k not in NOP_IDX]
        moved = [(k, a, b) for k, (a, b) in enumerate(zip(w1, stripped))
                 if a != b]
        ins = all((a >> 16) == (b >> 16) for k, a, b in moved)
    c.add('K3  positive control  P9-12 v2, %d B' % len(v2),
          sha2_ok and r2.loads == 2 and r2.nop_after == 2
          and not r2.violations and ins,
          '%d loads / %d nop / %d violations; v2 is v1 with nops at 0x20 and '
          '0x34 and %d displacement(s) moved, nothing else: %s'
          % (r2.loads, r2.nop_after, len(r2.violations), len(moved),
             'yes' if ins else 'NO'))

    # --- K4, the population control --------------------------------------
    if stage2_path is None:
        detail = ('NOT RUN -- stage2.bin was not found. Looked under $FWRE_WORK '
                  '(%s). Pass --stage2 PATH, or --no-population-control to look '
                  'at a file without certifying it'
                  % os.environ.get('FWRE_WORK', '/home/key/fwre-work'))
        if waive_population:
            c.add('K4  population control  stage2.bin', True,
                  'WAIVED by --no-population-control. Nothing this run says can '
                  'pass a gate; the exit code will be 2 either way')
        else:
            c.add('K4  population control  stage2.bin', False, detail)
    else:
        b = open(stage2_path, 'rb').read()
        sha = hashlib.sha256(b).hexdigest()
        # Through raw_span(), which is exactly what `--raw` builds for a user's
        # file.  It used to have its own private word list, so this control
        # exercised a code path no scanned file ever took -- it could not have
        # caught a defect in span construction, and it looked like it could.
        r = scan(raw_span(b, STAGE2_VMA))
        ok = (sha == STAGE2_SHA and len(b) == STAGE2_SIZE
              and r.loads == STAGE2_LOADS and r.nop_after == STAGE2_NOPS
              and len(r.violations) == STAGE2_VIOLATIONS)
        c.population_ran = ok
        c.add('K4  population control  stage2.bin', ok,
              '%d loads / %d nop (%.2f%%) / %d violations   expected %d / %d / %d'
              % (r.loads, r.nop_after, 100.0 * r.nop_after / max(r.loads, 1),
                 len(r.violations), STAGE2_LOADS, STAGE2_NOPS, STAGE2_VIOLATIONS)
              + ('' if sha == STAGE2_SHA else '   sha256 MISMATCH: %s' % sha))

    # --- K5 --------------------------------------------------------------
    swapped = b''.join(struct.pack('>I', struct.unpack_from('<I', v1, i)[0])
                       for i in range(0, len(v1), 4))
    n_swapped = len(scan(raw_span(swapped, PAYLOAD_VMA)).violations)
    n_shifted = len(scan(raw_span(v1[2:], PAYLOAD_VMA)).violations)
    c.add('K5  endianness and alignment',
          n_swapped != 2 and n_shifted != 2,
          'byte-swapped -> %d violations, 2-byte shifted -> %d; both must '
          'differ from 2' % (n_swapped, n_shifted))

    # --- K7, delay-slot successors ---------------------------------------
    # K1 is two words, so it cannot reach the shape that matters here: what
    # executes after a load that is ITSELF in a delay slot.  Every case below
    # puts a clean instruction on the leg that is not taken and a reading one on
    # the leg that is, so a checker that resolves to the wrong leg reports 0.
    # Added 2026-08-24; three of the four would have caught a defect that
    # shipped, and nothing in K1-K6 constrained any of them.
    bad7 = []
    for words, viol, unres, rel, why in K7_CASES:
        sp = Span(0, 4 * len(words), 0x80500000, 'K7', relocatable=rel)
        sp.words = [(0x80500000 + 4 * i, w) for i, w in enumerate(words)]
        r7 = scan([sp])
        if (len(r7.violations) != viol) or ((len(r7.unresolved) > 0) != unres):
            bad7.append('%s (got %d violations, %d unresolved)'
                        % (why, len(r7.violations), len(r7.unresolved)))
    c.add('K7  delay-slot successors', not bad7,
          '%d/%d ok' % (len(K7_CASES) - len(bad7), len(K7_CASES))
          + ('' if not bad7 else '   first miss: ' + bad7[0]))

    # --- K8, the span boundary -------------------------------------------
    # Two spans are not one run of instructions.  The last word of one is not
    # the predecessor of the first word of the next, and a flat word list makes
    # it one.  Expect: no violation across the seam, and an unresolved saying
    # why -- not silence.
    a = Span(0, 4, 0x80500000, 'first')
    a.words = [(0x80500000, 0x8D280000)]                  # lw t0,0(t1)
    bsp = Span(4, 4, 0x81000000, 'second')
    bsp.words = [(0x81000000, 0x01005021)]                # addu t2,t0,zero
    r8 = scan([a, bsp])
    c.add('K8  span boundary',
          len(r8.violations) == 0 and len(r8.unresolved) >= 1,
          '%d violations across the seam (must be 0), %d unresolved (must be '
          '>= 1): the two spans are not adjacent and the tool says so rather '
          'than reading across' % (len(r8.violations), len(r8.unresolved)))

    # --- K6, only where it is load-bearing -------------------------------
    if want_isa:
        if stage2_path is None:
            c.add('K6  ISA fixture  stage2.bin', bool(waive_population),
                  'NOT RUN -- stage2.bin was not found')
        else:
            b = open(stage2_path, 'rb').read()
            ws = raw_span(b, STAGE2_VMA)[0].words
            code = [x for x in ws if x[0] < STAGE2_CODE_HI]
            data = [x for x in ws if x[0] >= STAGE2_CODE_HI]
            s_code, l_code = isa_scan(code, True), isa_scan(code, False)
            movz = sorted(a for a, w, m, lv in s_code if m == 'movz')
            movn = sorted(a for a, w, m, lv in s_code if m == 'movn')
            addr_ok = (movz == STAGE2_MOVZ and movn == STAGE2_MOVN)
            c.add('K6a ISA fixture, code region',
                  len(s_code) == 18 and len(l_code) == 18 and addr_ok,
                  '%d hits strict, %d loose; movz x%d, movn x%d; the addresses '
                  'match docs §9 one for one: %s'
                  % (len(s_code), len(l_code), len(movz), len(movn),
                     'yes' if addr_ok else 'NO'))

            l_data, s_data = isa_scan(data, False), isa_scan(data, True)
            ll_hit = any(a == STAGE2_DATA_LL and m == 'll'
                         for a, w, m, lv in l_data)
            movn_hits = sorted(a for a, w, m, lv in l_data
                               if m == 'movn' and a in STAGE2_DATA_MOVN)
            c.add('K6b ISA fixture, the data region fires',
                  ll_hit and movn_hits == sorted(STAGE2_DATA_MOVN),
                  'loose finds ll at 0x%08x (%s) and %d/6 of the SPI table\'s '
                  '0x0000004b -- the two false positives docs §9 names'
                  % (STAGE2_DATA_LL, '192.168.0.1' if ll_hit else 'NOT FOUND',
                     len(movn_hits)))

            rejects = not any(a in STAGE2_DATA_MOVN for a, w, m, lv in s_data)
            c.add('K6c strict and loose disagree, which is the point',
                  rejects and len(l_data) != len(s_data),
                  'data region: %d loose, %d strict. Strict rejects the SPI '
                  'table\'s 0x4b because its sa field is 1: %s. A count quoted '
                  'without its classifier is not a measurement'
                  % (len(l_data), len(s_data), 'yes' if rejects else 'NO'))
    return c


