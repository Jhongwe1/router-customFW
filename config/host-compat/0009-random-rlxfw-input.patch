+/*
+ * rlxfw (R7, 2026-09-30): an entropy input whose credit policy is the
+ * CALLER's.
+ *
+ * 量 2026-09-30 on image r6b8i (recipe 3685a3a4):
+ * /proc/sys/kernel/random/entropy_avail reads 0 at 768 s of uptime and 0
+ * again at 1613 s, with poolsize 4096 (bench/2026-09-30/SB-ENT.log,
+ * SB-RT1.log).  讀, in this file: the only path an interrupt has into the
+ * pool is add_interrupt_randomness() above, which kernel/irq/handle.c calls
+ * only for a handler registered with IRQF_SAMPLE_RANDOM -- and no driver in
+ * this image registers that flag.  There is no keyboard, no mouse and no
+ * rotating disk, so add_input_randomness() and add_disk_randomness() never
+ * fire either.  Nothing credits the pool, so nothing ever will.
+ *
+ * 🔴 AND THE FLAG ALONE WOULD NOT HAVE FIXED IT.  add_timer_randomness()
+ * mixes get_cycles() for the sub-jiffy part and estimates its credit from
+ * jiffies deltas -- and arch/rlx/include/asm/timex.h defines get_cycles() as
+ * `return 0;` on this Lexra core.  The pool would receive a constant where
+ * the jitter belongs, and the estimate would come from a 100 Hz counter whose
+ * minimum first/second/third-order delta is 0 for almost every pair of
+ * packets.  It would produce a number, not entropy.
+ *
+ * So rlxfw supplies both the sample and the estimate.  mix_pool_bytes() and
+ * credit_entropy_bits() are static here, and that is the whole reason this
+ * function exists.  It deliberately makes NO estimate of its own: the one
+ * number that matters for security belongs in reviewed rlxfw code
+ * (drivers/char/rlxfw-entropy.c, whose header comment carries the policy and
+ * its derating), not in an estimator this board defeats.
+ *
+ * credit_bits <= 0 mixes without crediting, and mixing makes no claim.  Safe
+ * from hard-IRQ context: both callees take their own spin_lock_irqsave and
+ * neither sleeps.  Declared in <linux/rlxfw-entropy.h>, which is NOT included
+ * here on purpose -- this patch has to apply and compile on a tree where
+ * rlxfw's own sources were never staged (a build without --marks), and an
+ * unused non-static function costs that image ~40 bytes and nothing else.
+ */
+void rlxfw_random_add(const void *buf, unsigned int nbytes, int credit_bits)
+{
+	if (nbytes)
+		mix_pool_bytes(&input_pool, buf, (int)nbytes);
+	if (credit_bits > 0)
+		credit_entropy_bits(&input_pool, credit_bits);
+}
 
