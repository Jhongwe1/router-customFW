#
# rlxfw's top-level SDK selection -- the file the vendor's `make config` would
# have written, stated instead of clicked.
#
# WHY THIS IS IN THE REPOSITORY.  `arch/rlx/bsp/Makefile:10` and
# `net/rtl/fastpath/Makefile` both `include $(DIR_ROOT)/.config`, so the kernel
# build does not complete without it -- 量 2026-08-28: without this file the
# build stops at `net/rtl/fastpath` with *"No rule to make target
# '<top>/.config'"*.  It is normally produced by `config/mconf`, which is a
# curses program.  A build input that only exists because somebody once
# answered a menu is a build nobody else can reproduce, so the selections are
# written down here with the reason each one was made.
#
# Every line below is a SELECTION, not a measurement.  The four that matter:
#
#   CONFIG_BOARD_rtl8196e        this device's SoC (SPEC.md CPU-01/CPU-04)
#   CONFIG_MODEL_RTL8196E_88E_GW this unit's wireless part is the 88E; the
#                                other three models pull a different PHY
#   CONFIG_RSDK_rsdk-1.3.6-4181  Decision A, notes/kernel-build.md 1.  It is
#                                the only wrapper on hand that accepts
#                                -march=4181, and TC-17 records that the drop's
#                                own top-level .config selects this release for
#                                this board
#   CONFIG_LINUX_2.6.30          the only kernel in the drop, and the version
#                                this unit's own banner reports (FW-03)
#
# CONFIG_MCONF_* are all off deliberately: each one re-enters an interactive
# menuconfig, which a scripted build cannot answer.
#
# The trailing CONFIG_*DIR lines are what `config/setconfig`'s fix_conf_files()
# writes back after a menu run.  They are paths, and they are consistent with
# what tools/rlxfw-kbuild.sh stages.
#

#
# select components
#
# CONFIG_BOARD_rtl8196c is not set
CONFIG_BOARD_rtl8196e=y
# CONFIG_BOARD_rtl8196eu is not set
# CONFIG_BOARD_rtl8198 is not set
# CONFIG_BOARD_rtl819xD is not set
CONFIG_LINUX_2.6.30=y
CONFIG_BZBOX_busybox-1.13=y
CONFIG_RSDK_rsdk-1.3.6-4181-EB-2.6.30-0.9.30=y
# CONFIG_RSDK_rsdk-1.3.6-5281-EB-2.6.30-0.9.30 is not set
# CONFIG_RSDK_rsdk-1.5.5-5281-EB-2.6.30-0.9.30.3-110714 is not set

#
# rtl8196e
#
# CONFIG_MODEL_RTL8196E_92D_GW is not set
# CONFIG_MODEL_RTL8196E_92C_GW is not set
CONFIG_MODEL_RTL8196E_88E_GW=y
# CONFIG_MODEL_RTL8196E_MP is not set

#
# config components
#
# CONFIG_MCONF_LINUX is not set
# CONFIG_MCONF_BZBOX is not set
# CONFIG_MCONF_LOAD is not set
# CONFIG_MCONF_SAVE is not set
CONFIG_LINUXDIR=linux-2.6.30
CONFIG_BOARDDIR=boards/rtl8196e
CONFIG_BZBOXDIR=users/busybox-1.13
CONFIG_RSDKDIR=toolchain/rsdk-1.3.6-4181-EB-2.6.30-0.9.30
CONFIG_MODEL=RTL8196E_88E_GW
CONFIG_ROUTER=
