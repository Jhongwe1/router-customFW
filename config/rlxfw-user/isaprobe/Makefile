# config/rlxfw-user/isaprobe/Makefile -- builds `uprobe`, this project's first
# compiled userspace program, and `R1c`'s column-② instrument.
#
# WHAT IT LINKS, AND WHY THAT IS THE POINT
#
#   uprobe.c          this directory.  The harness: handler, controls, report.
#   cells4.S          tools/rlxprobe/, GENERATED by `tools/isapay.py emit`
#                     from `tools/isa-payload.tsv`.  Linked VERBATIM, the same
#                     file `probe4` links, so columns ① and ② are the same
#                     bytes at two privilege levels rather than two tables
#                     that happen to agree.
#
# `probe4rows.h` and `rlxasm.h` come from the same directory and are likewise
# not copied into this one.  A copy here would be a second owner of a
# population whose own header says it is the owner.
#
# ---------------------------------------------------------------------------
# WHY IT STAGES TO ext4 FIRST, 量 2026-09-15 with a three-arm control
# ---------------------------------------------------------------------------
#
# The rsdk driver and its `cc1` are `ELF 32-bit LSB executable, Intel 80386`.
# A 32-bit `stat()` cannot represent a DrvFs inode number, so every path under
# `/mnt/c` comes back `EOVERFLOW` and the compiler reports
#
#     cc1: <path>: Value too large for defined data type
#
# Measured, same compiler, same source bytes, only the filesystem differing:
# source on ext4 rc=0; byte-identical source on DrvFs rc=1; source on ext4
# with nothing but an `-I` pointing at DrvFs **also rc=1**.  ext4 inode
# 2,276,528 (fits in 32 bits); DrvFs inode 12,384,898,976,057,211 (does not).
#
# So the build may not so much as NAME a path inside this repository.  Four
# files are staged onto ext4 under `$FWRE_WORK/rebuild/`, which is where
# `CLAUDE.md` says derived artefacts go anyway, and the staged copies are
# hashed against the originals before anything is compiled -- the same reason
# `tools/desk-sweep.py` verifies its copy: the conclusion is about the
# repository, so a silent divergence between source and copy would be a
# measurement of the wrong tree.
#
# This is a third, independent reason for `CLAUDE.md`'s "binaries and vendor
# source trees never live under /mnt/c", and unlike the mode-bit and
# case-folding reasons it is a hard failure rather than a silent one.
#
# ---------------------------------------------------------------------------
# TOOLCHAIN
# ---------------------------------------------------------------------------
#
# Parameterised on purpose: `SPEC.md`'s TC-05 residual says the userspace
# toolchain is decided by the same criterion as the kernel's -- `tools/hazlint`
# with 0 violations -- and a criterion you cannot re-run against a different
# candidate is an assertion.  `make TC=<dir>` re-runs it.

SHELL      := /bin/sh
HERE       := $(dir $(abspath $(lastword $(MAKEFILE_LIST))))
REPO       := $(abspath $(HERE)../../..)
PROBE      := $(REPO)/tools/rlxprobe

FWRE_WORK  ?= /home/key/fwre-work
STAGE      ?= $(FWRE_WORK)/rebuild/rlxfw-user/isaprobe
SRC        := $(STAGE)/src
OBJ        := $(STAGE)/build
INSTALL    ?= $(REPO)/build/rlxfw-user/isaprobe

TCROOT     ?= $(FWRE_WORK)/rebuild/src-vendor/rtl819x-toolchain/toolchain
TC         ?= rsdk-1.3.6-4181-EB-2.6.30-0.9.30
TCBIN      := $(TCROOT)/$(TC)/bin

CC         := $(TCBIN)/mips-linux-gcc
OBJDUMP    := $(TCBIN)/mips-linux-objdump
READELF    := $(TCBIN)/mips-linux-readelf
STRIP      := $(TCBIN)/mips-linux-strip
NM         := $(TCBIN)/mips-linux-nm

HAZLINT    := $(REPO)/tools/hazlint
PYTHON     ?= /usr/bin/python3

# The four inputs, repo side and staged side, in one place so `stage` and the
# build-id digest cannot drift apart.
IN_NAMES   := uprobe.c cells4.S probe4rows.h rlxasm.h
IN_REPO    := $(HERE)uprobe.c $(PROBE)/cells4.S $(PROBE)/probe4rows.h $(PROBE)/rlxasm.h
IN_STAGE   := $(addprefix $(SRC)/,$(IN_NAMES))

# A digest over exactly the inputs that decide the artefact, so a board that
# prints it is naming a build rather than echoing a name someone typed.
# `RLXFW-ID0`'s shape, one level down.
BUILD_ID   := $(shell cat $(IN_REPO) 2>/dev/null | sha256sum | cut -c1-16)

# -Os            the initramfs lives inside the kernel image
# -static        this image's uClibc is the unit's, not this toolchain's, and
#                a dynamic link would make the measurement depend on a second
#                artefact nobody chose
# -fno-builtin   the harness must not have memcpy/strlen replaced by something
#                whose encoding this die has not been asked about
CFLAGS     := -Os -std=gnu99 -Wall -Wextra -Werror -Wundef -Wshadow \
              -fno-builtin -fno-strict-aliasing -fno-common \
              -I$(SRC) -DUPROBE_BUILD_ID='"$(BUILD_ID)"'

# 🔴 These two flags are INERT on this toolchain and the comment that used to
# be here said they were necessary.  量 2026-09-15, two arms: `cells4.S`
# assembled with `-mno-abicalls -fno-pic` and with the driver's default
# produce BYTE-IDENTICAL objects -- same `R_MIPS_HI16`/`R_MIPS_LO16` against
# `rlx_fault_frame` for rlxasm.h's SAFE_A0, same object flags `0x1001`, same
# linked-executable flags `0x1005`, and the same link warning.  The driver's
# `-mabicalls` reaches `cc1`, not `as`, and a hand-written `.S` with no
# `.abicalls` directive is non-PIC whichever way it is invoked.
#
# They stay as a PIN, not as a fix: if a future gas ever defaults the other
# way, this says which way this artefact was measured.  Saying so is the
# difference between a pin and a superstition.
ASFLAGS    := -Os -mno-abicalls -fno-pic -I$(SRC)

LDFLAGS    := -static

OBJS       := $(OBJ)/uprobe.o $(OBJ)/cells4.o
ELF        := $(OBJ)/uprobe.elf
BIN        := $(OBJ)/uprobe
OUT        := $(INSTALL)/uprobe

.PHONY: all stage build gate install show dis clean emit-check
all: install

# ---------------------------------------------------------------------------
# stage -- copy onto ext4, then PROVE the copy is the source
# ---------------------------------------------------------------------------
stage:
	@mkdir -p $(SRC) $(OBJ)
	@set -e; for f in $(IN_REPO); do cp -f "$$f" $(SRC)/; done
	@set -e; bad=0; \
	 for n in $(IN_NAMES); do \
	   case $$n in \
	     uprobe.c) s=$(HERE)uprobe.c ;; \
	     *)        s=$(PROBE)/$$n ;; \
	   esac; \
	   a=$$(sha256sum "$$s"      | cut -d' ' -f1); \
	   b=$$(sha256sum $(SRC)/$$n | cut -d' ' -f1); \
	   if [ "$$a" != "$$b" ]; then echo "STAGE MISMATCH: $$n"; bad=1; fi; \
	 done; \
	 [ $$bad = 0 ] || { echo "REFUSED: the staged copy is not the source"; exit 1; }
	@echo "staged 4 files to $(SRC), all four hashes equal to the repo's"

# The generator's own staleness gate, borrowed rather than re-implemented.
# `tools/rlxprobe/Makefile` runs the same check; running it here too means a
# hand-edited cells4.S cannot reach this artefact either.
emit-check:
	@echo '--- gate G0: isapay.py emit --check ---'
	@$(PYTHON) $(REPO)/tools/isapay.py emit --check

$(OBJ)/uprobe.o: stage
	$(CC) $(CFLAGS) -c $(SRC)/uprobe.c -o $@

$(OBJ)/cells4.o: stage
	$(CC) $(ASFLAGS) -c $(SRC)/cells4.S -o $@

$(ELF): emit-check $(OBJS)
	$(CC) $(LDFLAGS) -o $@ $(OBJS) 2>$(OBJ)/link.log; rc=$$?; \
	 cat $(OBJ)/link.log; exit $$rc

build: $(ELF)

# ---------------------------------------------------------------------------
# The gates.  A product that does not exist unless they pass, the same shape
# as `tools/rlxprobe/Makefile`'s.
#
# G1/G1b  `R1C-1-b`, written down 2026-09-14 and not built until now: the
#     linked binary must hold zero `break`, because gcc emits `break 7` for
#     integer division by zero and a `break` here is an exception the harness
#     did not intend -- it would arrive as SIGTRAP from a row that did not ask
#     for one.
#
#     🔴 THIS ARTEFACT DOES NOT MEET THAT AS LITERALLY WRITTEN, and the gate
#     says so rather than being narrowed quietly.  量 2026-09-15: the linked
#     ELF holds **two** `break 0xFF`, both inside `__GI_abort`, and `abort.os`
#     is pulled in by `__uClibc_main.os` -- the C runtime's own startup.  The
#     only way to zero is `-nostdlib` with a hand-written `_start`,
#     `rt_sigaction`, `sigsetjmp` and `siglongjmp`.
#
#     That trade was declined, with the reason written down: a hand-written
#     MIPS `sigsetjmp` that saves the wrong callee-saved register is SILENT,
#     and this whole instrument is a signal handler.  The risk of a quiet bug
#     in hand-marshalled signal plumbing is larger by far than the risk of two
#     `break`s in a function nothing calls.
#
#     So the gate becomes BOUNDED rather than waived -- the same shape as G4.
#     G1 is zero in code this project wrote; G1b is *exactly two, both inside
#     `__GI_abort`*, and it goes red if a third appears or if one moves.  The
#     agent's measurement of three candidate toolchains found **four** breaks
#     in every `printf`-using test binary (two in `__GI_fwrite_unlocked`'s
#     divide check, two in abort); this harness writes with `write(2)` and has
#     none of the fwrite pair.
#
#     🔴 And the count is taken BY OPCODE, never from objdump's mnemonic.
#     量 2026-09-15: the rsdk objdumps decline to name `movz`/`movn` and print
#     the raw word, so `grep objdump` is a lower bound wearing a total's
#     clothes.  `tools/elfops.py` decodes; `nm` supplies only the symbol
#     extent, which is the one thing it does not lie about here.
#
# G2  hazlint over the linked ELF.  `SPEC.md` TC-05's written criterion,
#     applied to the artefact rather than to a toolchain's name.
#
# G3  every cell has a `_w` symbol in the linked ELF.  This is what makes the
#     desk-side PC-identity control (C2) possible at all: the harness prints a
#     faulting PC and the desk resolves the expected address out of THIS
#     binary rather than out of a table compiled into it.
# ---------------------------------------------------------------------------
gate: $(ELF)
	@echo '--- gate G1: break count over our two objects, BY OPCODE ---'
	@n=$$($(PYTHON) $(REPO)/tools/elfops.py count $(OBJ)/uprobe.o --ops break --quiet | sed -n 's/^  break *//p'); \
	 m=$$($(PYTHON) $(REPO)/tools/elfops.py count $(OBJ)/cells4.o --ops break --quiet | sed -n 's/^  break *//p'); \
	 echo "break uprobe.o=$$n  cells4.o=$$m"; \
	 [ "$$n" = "0" ] && [ "$$m" = "0" ] || { echo "REFUSED: a break in code this project wrote"; exit 1; }
	@echo '--- gate G1b: the LINKED ELF, and every break in it named ---'
	@$(PYTHON) $(REPO)/tools/elfops.py where $(ELF) --op break > $(OBJ)/breaks.txt; \
	 n=$$(sed -n 's/^break *//p' $(OBJ)/breaks.txt); \
	 lo=$$($(NM) -S $(ELF) | awk '$$4=="__GI_abort"{printf "%d", strtonum("0x"$$1); exit}'); \
	 sz=$$($(NM) -S $(ELF) | awk '$$4=="__GI_abort"{printf "%d", strtonum("0x"$$2); exit}'); \
	 echo "linked break=$$n  __GI_abort=[$$lo,+$$sz)"; \
	 [ -n "$$lo" ] || { echo "REFUSED: no __GI_abort symbol to account against"; exit 1; }; \
	 out=0; \
	 for a in $$(grep -oE '^  0x[0-9A-F]+' $(OBJ)/breaks.txt | tr -d ' 	'); do \
	   d=$$(printf '%d' $$a); \
	   if [ $$d -lt $$lo ] || [ $$d -ge $$((lo + sz)) ]; then \
	     echo "  OUTSIDE __GI_abort: $$a"; out=$$((out + 1)); \
	   fi; \
	 done; \
	 [ "$$n" = "2" ] && [ "$$out" = "0" ] || { \
	   echo "REFUSED: expected exactly 2 breaks, both inside __GI_abort"; exit 1; }
	@echo '--- gate G2: hazlint over the linked ELF ---'
	@HAZLINT_CHILD=1 $(PYTHON) $(HAZLINT) $(ELF)
	@echo '--- gate G3: one _w symbol per row ---'
	@w=$$(awk '$$1=="#define" && $$2=="P4_ROWS" {gsub(/[^0-9]/,"",$$3); print $$3}' $(SRC)/probe4rows.h); \
	 s=$$($(NM) $(ELF) | grep -c '_w$$' || true); \
	 echo "rows=$$w  _w symbols=$$s"; \
	 [ "$$w" = "$$s" ] || { echo "REFUSED: $$s _w symbols for $$w rows"; exit 1; }
	@echo '--- gate G4: the link produced exactly the one known warning ---'
	@u=$$(grep -v 'warning: linking PIC files with non-PIC files' $(OBJ)/link.log | grep -c . || true); \
	 k=$$(grep -c 'warning: linking PIC files with non-PIC files' $(OBJ)/link.log || true); \
	 echo "known=$$k  unexpected=$$u"; \
	 [ "$$u" = "0" ] || { echo "REFUSED: the link said something new:"; \
	                      grep -v 'warning: linking PIC files with non-PIC files' $(OBJ)/link.log; exit 1; }

$(BIN): gate
	cp $(ELF) $@
	$(STRIP) $@

install: $(BIN)
	@mkdir -p $(INSTALL)
	cp -f $(BIN) $(OUT)
	@echo "installed $(OUT)  build_id=$(BUILD_ID)"

# Every number a bench card would state about this artefact, printed by the
# artefact's own build so the card quotes a measurement and not a memory.
show: install
	@echo "tc          $(TC)"
	@echo "build_id    $(BUILD_ID)"
	@echo "elf_bytes   $$(wc -c < $(ELF))"
	@echo "bin_bytes   $$(wc -c < $(BIN))"
	@echo "sha256      $$(sha256sum $(BIN) | cut -d' ' -f1)"
	@w=$$(sed -n 's/^#define[[:space:]]*P4_ROWS[[:space:]]*\([0-9][0-9]*\).*/\1/p' $(SRC)/probe4rows.h); echo "rows        $$w"
	@echo "cells_syms  $$($(NM) $(ELF) | grep -c '_w$$')"
	@echo "entry       $$($(READELF) -h $(ELF) | awk '/Entry point/{print $$4}')"
	@echo "flags       $$($(READELF) -h $(ELF) | awk -F'Flags:' '/Flags:/{print $$2}')"
	@echo "interp      $$($(READELF) -l $(ELF) | grep -c INTERP || true)"
	@echo "break_ours  $$($(OBJDUMP) -d $(OBJS) | grep -cE '\bbreak\b' || true)"

dis: $(ELF)
	$(OBJDUMP) -d $(ELF)

clean:
	rm -rf $(STAGE) $(INSTALL)
